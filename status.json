        },
        "signup": {
          "phone": "required",
          "realname": "required",
          "foreign_card": "unknown"
        },
        "confidence": "partial",
        "verified_at": "2026-09-30",
        "sources": [
          "https://modelscope.cn/docs/model-service/API-Inference/limits",
          "https://modelscope.cn/docs/model-service/API-Inference/intro",
          "https://modelscope.cn/docs/magicube/intro",
          "https://modelscope.cn/docs/accounts/registration",
          "https://modelscope.cn/api/v1/document/main_doc_CN_prod",
          "https://resouces.modelscope.cn/document/docdata/2026-9-28_15-49-CN/dist/model-service/API-Inference/limits/limits_CN.md"
        ],
        "access": {
          "difficulty_cn": "medium",
          "difficulty_reason": "对大陆开发者来说卡点和钱、卡都无关：手机号与身份证人皆有之，难在「不是注册即用」——注册完只能拿到 Access Token，还必须再注册/登录并绑定一个阿里云账号、再用手机支付宝或扫脸完成阿里云实名认证，API-Inference 才会放行。",
          "region": {
            "blocks_china": "no",
            "needs_non_cn_ip": "no",
            "detail": "官方没有任何限制中国大陆用户的条款，反而是明确面向内地用户。《用户协议与隐私政策》10.2 原文：「本社区旨在供中华人民共和国内地用户使用，我们不保证该服务适合或可供中国内地以外的地区访问或使用，请您谨慎操作并同意自行承担由此引发的风险。」同协议 2.1.2 要求用户保证「并非任何国家、国际组织或者地域实施的贸易限制、制裁或其他法律、规则限制的对象，否则您可能无法正常注册及使用本社区服务」。此外《用户协议》争议解决条款约定由浙江省杭州市西湖区人民法院管辖，社区运营主体与客服体系均在国内。因此大陆用户既不需要非中国 IP，也不需要任何形式的网络绕行工具；相反，非内地用户才属于官方声明「不保证」的范围。",
            "source": "https://resouces.modelscope.cn/document/docdata/2026-9-28_15-49-CN/dist/agreements/terms/terms_CN.md"
          },
          "payment": {
            "card_required_to_get_free": "no",
            "card_required_to_use_at_all": "no",
            "card_types": "在这条「拿免费 API-Inference key」的路径上，官方自始至终没有提出任何银行卡要求，因此不存在官方规定的可用卡种（Visa/Mastercard/银联等均无表述）。注册只要手机号；阿里云实名走支付宝或扫脸；推理服务本身免费。",
            "is_charge_incurred": "不涉及绑卡，也就没有 $0 预授权或强制充值。官方口径是 API-Inference「免费提供给广大开发者体验」「面向 ModelScope 注册用户免费提供」，额度用「魔粒」兑换而非充值：《魔粒体系说明》注册并登录 200 魔粒/日（短期，24 小时有效）、绑定阿里云账号后每日登录 50 魔粒/日（短期），另有验证邮箱/编辑个人介绍/配置个人主页各 50 魔粒（长期，90 天）等一次性激励；API-Inference 调用按模型档位扣 0.5 / 1 / 2 魔粒每次。官方全文未出现任何预授权、扣费或最低充值的说法。",
            "alternatives": "不需要任何支付工具即可完成注册、实名与免费调用。身份验证的替代选项即阿里云侧两种：手机支付宝 App 扫码授权（推荐，无需手输姓名身份证）或支付宝扫脸认证。魔粒不足时的官方建议是改用「API-Provider」绑定外部 API 提供方，而不是充值。",
            "source": "https://resouces.modelscope.cn/document/docdata/2026-9-28_15-49-CN/dist/model-service/API-Inference/limits/limits_CN.md ; https://resouces.modelscope.cn/document/docdata/2026-9-28_15-49-CN/dist/model-service/API-Inference/intro/intro_CN.md ; https://resouces.modelscope.cn/document/docdata/2026-9-28_15-49-CN/dist/magicube/intro/intro_CN.md ; https://help.aliyun.com/document_detail/48263.html"
          },
          "phone": {
            "required": "yes",
            "countries": "支持 +86 中国大陆号（平台面向内地用户）。官方《账号注册与登录》把「手机号码」列为注册必填项，并需接收短信验证码；《用户协议与隐私政策》2.2.2 原文：「您可以通过设置或确认的账户名、设置登录手机号码并完成动态验证、设置账号密码完成注册程序」。注册文档另列 CSDN / GitHub 三方登录入口，但未见「三方登录可免绑手机号」的说明。官方文档通篇未列出可用国家/区号清单，也未说明是否接受中国大陆以外的手机号 —— 因此「非 +86 号码能否注册」官方无表述，记 unknown；本次实际读到的官方页面上没有 +86 之外号码可用的依据。",
            "source": "https://resouces.modelscope.cn/document/docdata/2026-9-28_15-49-CN/dist/accounts/registration/registration_CN.md ; https://resouces.modelscope.cn/document/docdata/2026-9-28_15-49-CN/dist/agreements/terms/terms_CN.md"
          },
          "realname": {
            "required": "yes",
            "detail": "要拿到「能用的」API Key 必须实名，且实名发生在阿里云一侧而非魔搭社区内：拿到 Access Token 后还需绑定阿里云账号。《API推理介绍》原文：「注意: 账号注册后需绑定阿里云账号，并且通过实名认证后才可使用API-Inference。」《API-Inference 使用限制》原文：「免费推理API由阿里云提供算力支持，要求您的 ModelScope 账号必须首先绑定阿里云账号。同时为了防止滥用，对应云账号需已通过实名认证后，才可正常使用API-Inference。」绑定方式官方《阿里云账号绑定与授权教程》：在魔搭侧点「绑定阿里云账号」→ 登录/注册阿里云账号 → 在授权页勾选全部权限完成授权（RAM 账号另需策略/角色，流程更复杂）。阿里云《个人实名认证》给出的形式只有两种：①个人支付宝认证（手机支付宝 App 扫码授权，前提是「一个可以正常使用的、已经完成实名认证的个人支付宝账号」，且「目前不支持网页支付宝」）；②个人扫脸认证（输入姓名和身份证号码后扫脸）。企业实名认证为另一路径（微信公众平台认证/企业法人扫码/企业对公打款等），个人开发者用不到。",
            "source": "https://resouces.modelscope.cn/document/docdata/2026-9-28_15-49-CN/dist/model-service/API-Inference/intro/intro_CN.md ; https://resouces.modelscope.cn/document/docdata/2026-9-28_15-49-CN/dist/model-service/API-Inference/limits/limits_CN.md ; https://resouces.modelscope.cn/document/docdata/2026-9-28_15-49-CN/dist/accounts/aliyun-binding-and-authorization/aliyun-binding-and-authorization_CN.md ; https://help.aliyun.com/document_detail/48263.html"
          },
