      "env": "MODELSCOPE_KEY",
      "base_url": "https://api-inference.modelscope.cn/v1",
      "console": "https://modelscope.cn/my/myaccesstoken",
      "policy": {
        "free_kind": "长期免费",
        "limits": {
          "rpm": "未公布",
          "rpd": "未公布",
